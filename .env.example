# Copy to .env.local for local dev. On Vercel, add these in Project Settings > Environment Variables.

# Public URL of the deployed site (used for metadata, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://portofathur.vercel.app

# Resend (https://resend.com) API key
RESEND_API_KEY=re_your_api_key_here

# Inbox that receives contact form messages (default: fathurrahmanrifaldi@gmail.com)
CONTACT_TO_EMAIL=fathurrahmanrifaldi@gmail.com

# Sender address. Use onboarding@resend.dev until you verify your own domain in Resend.
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>